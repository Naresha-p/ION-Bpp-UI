# Copy to .env and fill in your values

# ── BPP UI REST API ───────────────────────────────────────────────────────────
# Dashboard, orders, and catalog management endpoints
VITE_BPP_UI_URL=https://tsp.nearshop.in/bpp-ui

# ── Resource / Publish API ────────────────────────────────────────────────────
# Add product (POST /resourse/add) and publish (POST /publish)
VITE_RESOURCE_URL=https://tsp.nearshop.in/bpp-ui

# ── Beckn Gateway ─────────────────────────────────────────────────────────────
# Protocol actions: search, select, init, confirm, status, track …
VITE_BECKN_BG_URL=http://localhost:5001

# ── BAP (Buyer Application Platform) credentials ─────────────────────────────
VITE_BAP_ID=ion-bap.example.id
VITE_BAP_URI=https://ion-bap.example.id/beckn

# ── BPP (Seller / Provider Platform) credentials ─────────────────────────────
VITE_BPP_ID=ion-bpp.example.id
VITE_BPP_URI=https://ion-bpp.example.id/beckn
